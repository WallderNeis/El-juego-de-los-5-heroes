[sub_resource type="GDScript" id="GDScript_qlphb"]
script/source = "extends CanvasLayer 


@onready var menu = $Menu

func _ready():

	menu.visible = false
	
	process_mode = Node.PROCESS_MODE_ALWAYS


func _input(event):
	
	if event.is_action_pressed(\"pausa\"):

		if get_tree().paused:
			reanudar_juego()
		else:
			pausar_juego()

func pausar_juego():
	get_tree().paused = true
	menu.visible = true  

func reanudar_juego():
	get_tree().paused = false
	menu.visible = false 


func _on_reanudar_pressed():
	reanudar_juego()
"

