[sub_resource type="GDScript" id="GDScript_2mv2k"]
script/source = "extends CharacterBody2D

var _velocidad: float = 200.0
var _velocidad_exploracion: float = 80.0 # Va más lento cuando no ve al jugador
@warning_ignore(\"unused_private_class_variable\")
var _velocidad_salto: float = -300.0
var personaje
var rango_vision: float = 300.0 

var atacando: bool = false
var jugador_en_rango: bool = false # Para saber si esta cerca cuando la espada golpee

# --- Variables nuevas para la Exploración ---
var direccion_exploracion: int = 0
var tiempo_exploracion: float = 0.0

@onready var animacion = $animacion
@onready var vision = $RayCast2D 

func _physics_process(delta):
	
	# 1. Buscar al jugador en el mapa si aún no lo tenemos
	if personaje == null:
		personaje = get_tree().current_scene.find_child(\"personaje\")
		
	# 2. Aplicar gravedad básica
	velocity += get_gravity() * delta
	
	# 3. Inteligencia Artificial y Visión
	if is_instance_valid(personaje) and not atacando:
		var distancia = global_position.distance_to(personaje.global_position)
		var puede_verlo = false
		
		# Si el jugador está dentro de su rango, activa el láser de visión
		if distancia <= rango_vision:
			
			# Apunta al pecho del jugador (restando 20 en Y) para no raspar el suelo
			vision.target_position = to_local(personaje.global_position + Vector2(0, -20))
			
			# Obliga al láser a actualizarse de inmediato
			vision.force_raycast_update()
			
			if vision.is_colliding():
				var objeto_visto = vision.get_collider()
				# Si lo primero que toca el láser es el personaje, significa que la vía está libre
				if objeto_visto != null and objeto_visto.name == \"personaje\":
					puede_verlo = true
		
		# --- COMPORTAMIENTO SEGÚN LO QUE VE ---
		if puede_verlo:
			# PERSEGUIR
			var direction = (personaje.global_position - global_position).normalized()
			velocity.x = direction.x * _velocidad
			
			# Voltear el dibujo horizontalmente según hacia dónde corre
			if direction.x > 0:
				animacion.flip_h = false # Mira a la derecha
			elif direction.x < 0:
				animacion.flip_h = true  # Mira a la izquierda
				
		else:
			# EXPLORAR / PATRULLAR
			# Restamos el tiempo en cada fotograma
			tiempo_exploracion -= delta
			
			# Si el tiempo se acaba, elegimos qué hacer a continuación
			if tiempo_exploracion <= 0:
				# randi_range(-1, 1) nos da -1 (izquierda), 0 (quieto), o 1 (derecha)
				direccion_exploracion = randi_range(-1, 1)
				# Decidimos cuánto tiempo hará esta acción (entre 1 y 3 segundos)
				tiempo_exploracion = randf_range(1.0, 3.0)
				
			# Aplicamos la velocidad de exploración (más lenta que la de persecución)
			velocity.x = direccion_exploracion * _velocidad_exploracion
			
			# Voltear el dibujo horizontalmente mientras patrulla
			if direccion_exploracion > 0:
				animacion.flip_h = false # Mira a la derecha
			elif direccion_exploracion < 0:
				animacion.flip_h = true  # Mira a la izquierda

	else:
		# Si está ejecutando el ataque, se frena en seco para dar el golpe
		velocity.x = move_toward(velocity.x, 0, _velocidad)

	# 4. Mover al enemigo físicamente
	move_and_slide()
	
	# 5. Control de animaciones (Mejorado)
	if atacando:
		if animacion.animation != \"atacar\":
			animacion.play(\"atacar\")
	else:
		# Comprobamos si se está moviendo usando abs() (que convierte negativos en positivos)
		if abs(velocity.x) > 0:
			# Si va muy rápido, usa la animación de correr, sino, la de caminar
			if abs(velocity.x) > _velocidad_exploracion:
				animacion.play(\"correr\")
			else:
				animacion.play(\"caminar\") 
		else:
			animacion.play(\"idle\")



# --- SEÑALES DE LA ZONA DE DAÑO (Tu Area2D llamada ZonaDaño) ---

func _on_zona_daño_body_entered(body):
	if body.name == \"personaje\":
		jugador_en_rango = true
		atacando = true 
		

func _on_zona_daño_body_exited(body):
	if body.name == \"personaje\":
		jugador_en_rango = false


# --- SEÑALES DEL NODO DE ANIMACIÓN 

func _on_animacion_frame_changed():
	if animacion.animation == \"atacar\":
		# Comprueba si va por el fotograma del espadazo 
		if animacion.frame == 2:
			# Solo si el jugador sigue dentro del rango de golpe, se aplica el daño
			if jugador_en_rango == true:
				personaje.recibir_daño(15.0, global_position.x)


func _on_animacion_animation_finished():
	if animacion.animation == \"atacar\":
		# Cuando termina por completo la animación de ataque, vuelve a caminar
		atacando = false
"

