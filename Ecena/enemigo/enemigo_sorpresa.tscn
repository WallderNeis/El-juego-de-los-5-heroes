script/source = "extends Area2D

@onready var enemigo = $\"../enemigosorpresa\"



func _on_body_entered(body: Node2D) -> void:
	
	if body.is_in_group(\"jugador\"):
		enemigo.saltar()
	
"

[sub_resource type="RectangleShape2D" id="RectangleShape2D_tg0u3"]
size = Vector2(89.8125, 475.0625)

[sub_resource type="GDScript" id="GDScript_fu1om"]
script/source = "extends Area2D

var activado = false
var regresando = false
var velocidad_subida = 400 
var altura_maxima = 300 
var posicion_inicial: Vector2

func _ready():
	
	posicion_inicial = position

func _process(delta):
	if activado:
	
		position.y -= velocidad_subida * delta
		
		
		if position.y <= posicion_inicial.y - altura_maxima:
			activado = false
			esperar_y_bajar()
			
	elif regresando:
		
		position.y += velocidad_subida * delta
		
	
		if position.y >= posicion_inicial.y:
			position = posicion_inicial
			regresando = false


func esperar_y_bajar():

	await get_tree().create_timer(0.5).timeout
	regresando = true
	
func saltar():
	if not activado and not regresando:
		activado = true


func _on_body_entered(body: Node2D) -> void:
	
	if body.name == \"personaje\":
		body.recibir_daño(15.0, global_position.x)
		

		
"

