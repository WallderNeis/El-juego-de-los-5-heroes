[sub_resource type="GDScript" id="GDScript_oc47h"]
script/source = "extends CharacterBody2D

# Configuración de nodos
@onready var animacion = $animacion
@onready var raycast_agarrarse = $RayCast2D
@onready var cuerda_gancho: Line2D = $CuerdaGancho
@onready var punta_gancho: Sprite2D = $PuntaGancho
@onready var forma_colision: CollisionShape2D = _buscar_forma_colision()
@export var area_2d: Area2D
@export var mapa_tiles: TileMapLayer
@export var barra_salud: ProgressBar

# Movimiento terrestre
var _velocidad_caminar: float = 320.0
var _velocidad_correr: float = 500.0
var _velocidad_salto: float = -400.0
var esta_corriendo: bool = false
var tiempo_doble_toque: float = 0.0
var ultima_direccion: int = 0
var cooldown_correr: float = 0.0
var jump_count = 0
const TIEMPO_MAX_DOBLE_TOQUE: float = 0.25
const TIEMPO_COOLDOWN_CORRER: float = 2.0
const VELOCIDAD_TREPADO_MAXIMA = 0.0
const max_jumps = 2

# Dash e invulnerabilidad
var esta_dasheando: bool = false
var tiempo_dash: float = 0.2
var tiempo_dash_restante: float = 0.0
var velocida_dash: float = 900.0
var direccion_dash: float = 0.0
var es_invulnerable: bool = false
var tiempo_invulnerable: float = 0.3
var tiempo_invulnerable_restante: float = 0.0
var segmentos_actuales: float = 5.0
var segmentos_maximos: float = 5.0
var costo_por_dash: float = 1.0
const RECARGA_SEGMENTOS_POR_SEGUNDO: float = 0.5

# Atravesar enemigos durante el dash
var atravesando_enemigos: bool = false
const CAPA_JUGADOR: int = 3
const CAPA_JUGADOR_DASH: int = 8
const CAPA_ENEMIGOS: int = 7

# Salud y daño
var salud_actual: float = 100.0
var salud_maxima: float = 100.0
var esta_herido: bool = false

# Hundimiento (zonas de daño tipo arenas movedizas o ácido)
var tiempo_hundimiento: float = 0.0
var cooldown_daño_hundimiento: float = 0.0
var tiempo_total_hundido: float = 0.0
const VELOCIDAD_HUNDIMIENTO: float = 60.0      # velocidad máxima de caída dentro de la zona
const VELOCIDAD_NADAR: float = 140.0           # velocidad al subir manteniendo saltar
const FACTOR_VELOCIDAD_HUNDIDO: float = 0.4    # multiplicador de velocidad al caminar
const FACTOR_SALTO_HUNDIDO: float = 0.6        # multiplicador de la fuerza de salto
const INTERVALO_DAÑO_HUNDIMIENTO: float = 0.5  # segundos entre cada golpe de daño
const DURACION_RAMPA_DAÑO: float = 4.0         # segundos hasta llegar al daño máximo
const DAÑO_MINIMO_FACTOR: float = 0.4          # fracción del daño máximo al entrar

# Ataque y combo
var esta_atacando: bool = false
var tiempo_ataque: float = 0.0
var frame_ataque: int = 0
var tiempo_combo: float = 0.0
var ataque_base = 5.0
var daño_actual = ataque_base
const TIEMPO_REINICIO_ATAQUE: float = 0.2

# Gancho
var usando_gancho: bool = false
var punto_gancho: Vector2 = Vector2.ZERO
var longitud_cuerda_actual: float = 160.0
const RANGO_MAX_GANCHO: float = 260.0
const VELOCIDAD_GANCHO: float = 750.0
const DISTANCIA_FRENO_GANCHO: float = 160.0


# Inicialización
func _ready():
	if area_2d:
		area_2d.body_entered.connect(_on_area_2d_body_entered)
	cuerda_gancho.visible = false
	punta_gancho.visible = false
	punta_gancho.z_index = 1
	cuerda_gancho.z_index = 0

func _buscar_forma_colision() -> CollisionShape2D:
	for hijo in get_children():
		if hijo is CollisionShape2D:
			return hijo as CollisionShape2D
	return null

# Físicas y movimiento
func _physics_process(delta):
	# Estos procesos se ejecutan siempre,
	# incluso mientras se usa el gancho
	procesar_doble_toque(delta)
	recargar_dash(delta)
	actualizar_atravesar()
	procesar_hundimiento(delta)

	if Input.is_action_just_pressed(\"gancho\") and not esta_herido:
		if usando_gancho:
			soltar_gancho()
		else:
			lanzar_gancho_automatico()

	if usando_gancho:
		procesar_gancho(delta)
		return

	if Input.is_action_just_pressed(\"dash\") and puede_dash():
		iniciar_dash()

	if esta_dasheando:
		procesar_dash(delta)
		return

	procesar_gravedad(delta)
	procesar_salto()
	procesar_caminar()
	move_and_slide()
	procesar_animaciones()

func procesar_gancho(delta):
	if esta_herido:
		soltar_gancho()
		return
		
	var distancia = global_position.distance_to(punto_gancho)
	var dir_al_bloque = global_position.direction_to(punto_gancho)
	
	cuerda_gancho.points = [Vector2.ZERO, to_local(punto_gancho)]
	punta_gancho.global_position = punto_gancho
	punta_gancho.rotation = global_position.angle_to_point(punto_gancho) + deg_to_rad(180)
	
	if distancia > longitud_cuerda_actual + 5.0:
		velocity = dir_al_bloque * VELOCIDAD_GANCHO
	else:
		velocity += get_gravity() * delta
		var input_balanceo = Input.get_axis(\"izquierda\", \"derecha\")
		velocity.x += input_balanceo * 900.0 * delta
		
		if input_balanceo > 0:
			animacion.flip_h = false
		elif input_balanceo < 0:
			animacion.flip_h = true
			
		if input_balanceo == 0:
			velocity.x = move_toward(velocity.x, 0, 300 * delta)
			
		var dir_desde_gancho = punto_gancho.direction_to(global_position)
		
		# Usar longitud_cuerda_actual para evitar el teletransporte brusco
		global_position = punto_gancho + dir_desde_gancho * longitud_cuerda_actual
		
		var tangente = Vector2(-dir_desde_gancho.y, dir_desde_gancho.x)
		velocity = tangente * velocity.dot(tangente)
	
	if Input.is_action_just_pressed(\"saltar\"):
		soltar_gancho()
		velocity.y = _velocidad_salto
		
		var input_balanceo = Input.get_axis(\"izquierda\", \"derecha\")
		if input_balanceo != 0:
			velocity.x = input_balanceo * 600.0
		else:
			velocity.x = velocity.x * 1.5
		jump_count = 1
		
	move_and_slide()

func procesar_doble_toque(delta):
	if tiempo_doble_toque > 0:
		tiempo_doble_toque -= delta

	# El temporizador se descuenta siempre que esté activo,
	# sin depender de esta_corriendo
	if cooldown_correr > 0:
		cooldown_correr -= delta
		if cooldown_correr <= 0:
			cooldown_correr = 0.0
			esta_corriendo = false
		
	if Input.is_action_just_pressed(\"derecha\"):
		if tiempo_doble_toque > 0 and ultima_direccion == 1:
			activar_correr()
		else:
			tiempo_doble_toque = TIEMPO_MAX_DOBLE_TOQUE
			ultima_direccion = 1

	if Input.is_action_just_pressed(\"izquierda\"):
		if tiempo_doble_toque > 0 and ultima_direccion == -1:
			activar_correr()
		else:
			tiempo_doble_toque = TIEMPO_MAX_DOBLE_TOQUE
			ultima_direccion = -1

func activar_correr():
	esta_corriendo = true
	cooldown_correr = TIEMPO_COOLDOWN_CORRER

func detener_correr():
	esta_corriendo = false
	cooldown_correr = 0.0

# Dash
func puede_dash() -> bool:
	return segmentos_actuales >= costo_por_dash and not esta_herido and not esta_dasheando

func iniciar_dash():
	segmentos_actuales -= costo_por_dash
	esta_dasheando = true
	tiempo_dash_restante = tiempo_dash
	
	# Invulnerabilidad durante el dash
	es_invulnerable = true
	tiempo_invulnerable_restante = tiempo_invulnerable
	
	# Dirección: la del input; si no hay, hacia donde mira el personaje
	var input_dir = Input.get_axis(\"izquierda\", \"derecha\")
	if input_dir != 0:
		direccion_dash = sign(input_dir)
	else:
		direccion_dash = -1.0 if animacion.flip_h else 1.0
	animacion.flip_h = direccion_dash < 0
	
	# El dash cancela el ataque en curso
	reiniciar_ataque()
	
	# Esquivar no debe romper el combo: se renueva su tiempo si estaba activo
	if tiempo_combo > 0:
		tiempo_combo = max(tiempo_combo, 1.0)
	
	# Atraviesa a los enemigos mientras dura el dash
	activar_atravesar()
	
	if animacion.sprite_frames.has_animation(\"dash\"):
		animacion.play(\"dash\")

func procesar_dash(delta):
	velocity.x = direccion_dash * velocida_dash
	velocity.y = 0
	move_and_slide()
	
	tiempo_dash_restante -= delta
	if tiempo_dash_restante <= 0:
		esta_dasheando = false
		velocity.x = 0

func recargar_dash(delta):
	# Los segmentos solo se recargan mientras estás en el suelo
	if is_on_floor() and segmentos_actuales < segmentos_maximos:
		segmentos_actuales = min(segmentos_actuales + RECARGA_SEGMENTOS_POR_SEGUNDO * delta, segmentos_maximos)
	
	# Temporizador de invulnerabilidad
	if es_invulnerable:
		tiempo_invulnerable_restante -= delta
		if tiempo_invulnerable_restante <= 0:
			es_invulnerable = false

# Atravesar enemigos: durante el dash el personaje pasa a la capa JugadorDash
# y deja de escanear la capa de enemigos. Así ni él los empuja ni ellos a él.
func activar_atravesar():
	atravesando_enemigos = true
	set_collision_layer_value(CAPA_JUGADOR, false)
	set_collision_layer_value(CAPA_JUGADOR_DASH, true)
	set_collision_mask_value(CAPA_ENEMIGOS, false)

func restaurar_colision():
	atravesando_enemigos = false
	set_collision_layer_value(CAPA_JUGADOR_DASH, false)
	set_collision_layer_value(CAPA_JUGADOR, true)
	set_collision_mask_value(CAPA_ENEMIGOS, true)

func actualizar_atravesar():
	# Tras el dash, la colisión solo se devuelve cuando no hay un enemigo
	# encima, para que nadie salga disparado al solaparse
	if atravesando_enemigos and not esta_dasheando and not hay_enemigo_encima():
		restaurar_colision()

func hay_enemigo_encima() -> bool:
	if forma_colision == null:
		return false
	var consulta = PhysicsShapeQueryParameters2D.new()
	consulta.shape = forma_colision.shape
	consulta.transform = forma_colision.global_transform
	consulta.collision_mask = 1 << (CAPA_ENEMIGOS - 1)
	var resultado = get_world_2d().direct_space_state.intersect_shape(consulta, 1)
	return not resultado.is_empty()

# Hundimiento
func procesar_hundimiento(delta):
	if tiempo_hundimiento > 0.0:
		tiempo_hundimiento -= delta
		tiempo_total_hundido += delta
	else:
		tiempo_total_hundido = 0.0
	if cooldown_daño_hundimiento > 0.0:
		cooldown_daño_hundimiento -= delta

func hundirse(cantidad_daño: float):
	# La zona de daño lo llama en cada frame mientras el personaje está dentro.
	# Lo hunde y le hace daño cada cierto intervalo, sin rebote ni aturdimiento.
	tiempo_hundimiento = 0.1
	
	if es_invulnerable or cooldown_daño_hundimiento > 0.0:
		return
	cooldown_daño_hundimiento = INTERVALO_DAÑO_HUNDIMIENTO
	
	# El daño crece cuanto más tiempo llevas dentro
	var progreso: float = clampf(tiempo_total_hundido / DURACION_RAMPA_DAÑO, 0.0, 1.0)
	var daño_final: float = lerpf(cantidad_daño * DAÑO_MINIMO_FACTOR, cantidad_daño, progreso)
	
	salud_actual -= daño_final
	actualizar_salud()
	print(salud_actual)
	
	if salud_actual <= 0:
		get_tree().call_deferred(\"reload_current_scene\")
		return
	
	# Parpadeo rojo corto como aviso de daño
	animacion.modulate = Color.RED
	await get_tree().create_timer(0.15).timeout
	if not esta_herido:
		animacion.modulate = Color.WHITE

func procesar_gravedad(delta):
	var esta_en_pared_pegajosa = revisa_pared_pegajosa()
	
	if not is_on_floor():
		if esta_en_pared_pegajosa and velocity.y > 0 and not esta_herido:
			velocity.y = VELOCIDAD_TREPADO_MAXIMA
			jump_count = 0
		else:
			velocity += get_gravity() * delta
	else:
		jump_count = 0
	
	# Hundiéndose: caes lento y, si mantienes saltar, nadas hacia arriba
	if tiempo_hundimiento > 0.0:
		jump_count = 0
		if Input.is_action_pressed(\"saltar\"):
			velocity.y = move_toward(velocity.y, -VELOCIDAD_NADAR, 1500.0 * delta)
		else:
			velocity.y = min(velocity.y, VELOCIDAD_HUNDIMIENTO)

func procesar_salto():
	if Input.is_action_just_pressed(\"saltar\") and jump_count < max_jumps:
		var fuerza_salto = _velocidad_salto
		if tiempo_hundimiento > 0.0:
			fuerza_salto *= FACTOR_SALTO_HUNDIDO
		velocity.y = fuerza_salto
		jump_count += 1
		animacion.play(\"saltar\")
		animacion.frame = 0

func procesar_caminar():
	if esta_herido:
		return
		
	var velocidad_actual = _velocidad_correr if esta_corriendo else _velocidad_caminar
	if tiempo_hundimiento > 0.0:
		velocidad_actual *= FACTOR_VELOCIDAD_HUNDIDO
	
	if Input.is_action_pressed(\"derecha\"):
		animacion.flip_h = false
		velocity.x = velocidad_actual
		raycast_agarrarse.target_position.x = abs(raycast_agarrarse.target_position.x)
	elif Input.is_action_pressed(\"izquierda\"):
		velocity.x = -velocidad_actual
		animacion.flip_h = true
		raycast_agarrarse.target_position.x = -abs(raycast_agarrarse.target_position.x)
	else:
		velocity.x = 0
		# Al soltar la tecla también se cancela el temporizador
		detener_correr()

func procesar_animaciones():
	if esta_herido or esta_atacando or esta_dasheando:
		pass
	elif not is_on_floor():
		if animacion.animation != \"saltar\":
			animacion.play(\"saltar\")
	elif velocity.x != 0:
		animacion.play(\"correr\")
	else:
		animacion.play(\"idle\")

# Ataque: cada toque avanza un frame de la animación.
# Si dejas de tocar (aunque sea a mitad de la animación o con un solo toque),
# la animación se quita rápido y se reinicia.
func _process(delta):
	if esta_atacando:
		tiempo_ataque -= delta
		if tiempo_ataque <= 0.0:
			reiniciar_ataque()

	if Input.is_action_just_pressed(\"Atacar\") and is_on_floor() and not esta_herido and not esta_dasheando:
		var total_frames = animacion.sprite_frames.get_frame_count(\"Atacar\")
		
		if not esta_atacando:
			# Primer toque: arranca desde el frame 0
			esta_atacando = true
			animacion.animation = \"Atacar\"
			animacion.pause()
			animacion.frame = 0
		else:
			# Toques siguientes: avanza un frame (vuelve al 0 al llegar al final)
			animacion.animation = \"Atacar\"
			animacion.pause()
			animacion.frame = (animacion.frame + 1) % total_frames
		
		# Cada toque reinicia el tiempo de espera
		tiempo_ataque = TIEMPO_REINICIO_ATAQUE
		ejecutar_ataque()
			
	if tiempo_combo > 0:
		tiempo_combo -= delta
		if tiempo_combo <= 0:
			daño_actual = ataque_base
			frame_ataque = 0
			print(\"Se acabó el tiempo. Daño reiniciado a: \", daño_actual)

func reiniciar_ataque():
	esta_atacando = false
	tiempo_ataque = 0.0
	animacion.frame = 0

func ejecutar_ataque():
	if tiempo_combo > 0.0:
		daño_actual = min(daño_actual * 1.15, 20.0)
	else:
		daño_actual = ataque_base
		
	tiempo_combo = max(tiempo_ataque + 0.4, 1.0)
	print(\"Daño de este golpe: \", daño_actual)

# Interacción y utilidades
func recibir_daño(cantidad: float, posicion_enemigo_x: float):
	# El dash esquiva el daño
	if es_invulnerable:
		return
	if esta_herido:
		return
		
	esta_herido = true
	esta_dasheando = false
	reiniciar_ataque()
	animacion.modulate = Color.RED
	salud_actual -= cantidad
	actualizar_salud()
	print(salud_actual)

	velocity.y = -450
	
	if animacion.flip_h == true:
		velocity.x = -250
	else:
		velocity.x = 250
		
	if salud_actual <= 0:
		get_tree().call_deferred(\"reload_current_scene\")
		
	await get_tree().create_timer(0.3).timeout
	esta_herido = false
	velocity.x = 0
	animacion.modulate = Color.WHITE

func actualizar_salud():
	if barra_salud:
		barra_salud.actualizar_barra(salud_maxima, salud_actual)

func revisa_pared_pegajosa() -> bool:
	if raycast_agarrarse.is_colliding():
		var objeto_chocado = raycast_agarrarse.get_collider()
		if objeto_chocado and objeto_chocado.is_in_group(\"pegajoso\"):
			return true
	return false

func _on_area_2d_body_entered(body: Node2D) -> void:
	pass

# Gancho (Mecánicas de TileMap)
func lanzar_gancho_automatico() -> void:
	if not mapa_tiles:
		return

	var celda_jugador = mapa_tiles.local_to_map(mapa_tiles.to_local(global_position))
	var tamano_celda = mapa_tiles.tile_set.tile_size.x
	var radio_celdas = int(ceil(RANGO_MAX_GANCHO / tamano_celda))

	var menor_distancia: float = RANGO_MAX_GANCHO
	var bloque_encontrado: bool = false
	var posicion_objetivo: Vector2 = Vector2.ZERO

	for x in range(celda_jugador.x - radio_celdas, celda_jugador.x + radio_celdas + 1):
		for y in range(celda_jugador.y - radio_celdas, celda_jugador.y + radio_celdas + 1):
			var celda = Vector2i(x, y)
			var tile_data = mapa_tiles.get_cell_tile_data(celda)
			
			if tile_data and tile_data.get_custom_data(\"es_gancho\"):
				var pos_bloque = mapa_tiles.to_global(mapa_tiles.map_to_local(celda)) + Vector2(0, 40)
				var dist = global_position.distance_to(pos_bloque)
				
				if dist < menor_distancia:
					menor_distancia = dist
					posicion_objetivo = pos_bloque
					bloque_encontrado = true

	if bloque_encontrado:
		punto_gancho = posicion_objetivo
		usando_gancho = true
		esta_dasheando = false
		
		# Guardar la distancia real al momento de engancharse para no forzar la cámara
		var distancia_inicial = global_position.distance_to(punto_gancho)
		longitud_cuerda_actual = min(distancia_inicial, DISTANCIA_FRENO_GANCHO)
		
		detener_correr()
		reiniciar_ataque()
		jump_count = 0
		cuerda_gancho.visible = true
		punta_gancho.visible = true

func soltar_gancho() -> void:
	usando_gancho = false
	cuerda_gancho.visible = false
	punta_gancho.visible = false
"

